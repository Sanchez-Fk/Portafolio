# Copia este archivo a `.env` (mismo directorio) y rellena los valores.
#   cp .env.example .env
# `.env` está en .gitignore. No lo subas al repo.

# ─── Zona horaria ────────────────────────────────────────────────────────────
TZ=America/Bogota

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=lumina
# Genera una: openssl rand -hex 24
POSTGRES_PASSWORD=CAMBIA_ESTO

# ─── Evolution API (gateway de WhatsApp) ─────────────────────────────────────
# Genera una: openssl rand -hex 32
EVOLUTION_API_KEY=CAMBIA_ESTO
EVOLUTION_PUERTO=8080
# URL con la que Evolution se referencia a sí misma. En local déjala así;
# en un VPS pon https://wa.tudominio.com
EVOLUTION_URL_PUBLICA=http://localhost:8080
# Nombre de la instancia = tu línea de WhatsApp. Un nombre por número.
EVOLUTION_INSTANCIA=lumina

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_PUERTO=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_URL_PUBLICA=http://localhost:5678
# Genera una: openssl rand -hex 32
# Si la cambias después, n8n ya no puede descifrar las credenciales guardadas.
N8N_ENCRYPTION_KEY=CAMBIA_ESTO

# ─── Anthropic (redacta los mensajes) ────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-CAMBIA_ESTO

# ─── Operación ───────────────────────────────────────────────────────────────
# Tu propio número, para que el bot te avise cuando un lead se calienta.
# Formato E.164 sin '+'.
TELEFONO_NOTIFICACIONES=573052624583
# Prefijo de país por defecto al importar números sin código (Colombia = 57).
PAIS_POR_DEFECTO=57
